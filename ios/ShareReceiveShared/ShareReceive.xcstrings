    "打开月读后将自动导入。同名文件会询问是否替换。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开月读后将自动导入。同名文件会询问是否替换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Moonread to import automatically. You’ll be asked before replacing a file with the same name."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開月讀後將自動匯入。同名檔案會詢問是否取代。"
          }
        }
      }
    },
    "无法访问分享暂存，请稍后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问分享暂存，请稍后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared storage is unavailable. Please try again later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取分享暫存，請稍後重試。"
          }
        }
      }
    },
    "仅支持 TXT 文件。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持 TXT 文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only TXT files are supported."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅支援 TXT 檔案。"
          }
        }
      }
    },
    "分享清单无法读取，暂存文件已保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享清单无法读取，暂存文件已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share manifest couldn’t be read. Staged files have been kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享清單無法讀取，暫存檔案已保留。"
          }
        }
      }
    },
    "分享清单版本 %lld 暂不支持，暂存文件已保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
