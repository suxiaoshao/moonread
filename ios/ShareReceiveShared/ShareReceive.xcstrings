          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share manifest version %lld isn’t supported. Staged files have been kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享清單版本 %lld 暫不支援，暫存檔案已保留。"
