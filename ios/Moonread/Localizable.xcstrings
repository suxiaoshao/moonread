    "对话模型": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Conversation Model"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "對話模型"}}}},
    "你": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "你"}}}},
    "等待回复": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for Response"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "等待回覆"}}}},
    "正在生成": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Generating"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在生成"}}}},
    "回复已中断，可继续提问。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This reply was interrupted. You can continue the conversation."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "回覆已中斷，可繼續提問。"}}}},
    "添加 Codex 连接": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Codex Connection"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "新增 Codex 連線"}}}},
    "问题与有限阅读上下文发送给所选服务。Codex 使用你登录账户的权限；月读不提供额度，也不自动切换计费连接。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your question and limited reading context are sent to the selected service. Codex uses your signed-in account permissions. Moonread provides no quota and never switches billing connections automatically."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "問題與有限閱讀上下文傳送給所選服務。Codex 使用你登入賬戶的許可權；月讀不提供額度，也不自動切換計費連線。"}}}},
    "默认文本模型": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Default Text Model"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "預設文本模型"}}}},
    "连接": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connections"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "連線"}}}},
    "服务": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Service"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "服務"}}}},
    "额度来源": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Billing"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "額度來源"}}}},
    "订阅账户": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription Account"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "訂閱賬戶"}}}},
    "退出登录": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign Out"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "退出登入"}}}},
    "登录 Codex": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign In to Codex"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "登入 Codex"}}}},
    "复制登录码": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy Login Code"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "複製登入碼"}}}},
    "打开 OpenAI 登录页": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open OpenAI Sign-In"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "開啟 OpenAI 登入頁"}}}},
    "请本人在 OpenAI 页面输入登录码并完成授权，月读会继续等待。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the code and authorize on the OpenAI page yourself. Moonread will keep waiting."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請本人在 OpenAI 頁面輸入登入碼並完成授權，月讀會繼續等待。"}}}},
    "正在连接": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connecting"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在連線"}}}},
    "取消登录": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel Sign-In"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "取消登入"}}}},
    "模型": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Models"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "模型"}}}},
    "刷新可用模型": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh Available Models"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新整理可用模型"}}}},
    "上下文容量": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Context Capacity"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "上下文容量"}}}},
    "思考强度": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reasoning Effort"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "思考強度"}}}},
    "服务默认": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Service Default"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "服務預設"}}}},
    "选择对话": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose Conversation"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇對話"}}}},
    "月读助手": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Moonread Assistant"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "月讀助手"}}}},
    "打开对话": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open conversation"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "開啟對話"}}}},
    "%lld 个连接": {
  "localizations": {
    "en": {
      "variations": {
        "plural": {
          "one": {
            "stringUnit": {
              "state": "translated",
              "value": "%lld connection"
            }
          },
          "other": {
            "stringUnit": {
              "state": "translated",
              "value": "%lld connections"
            }
          }
        }
      }
    },
    "zh-Hant": {
      "stringUnit": {
        "state": "translated",
        "value": "%lld 個連線"
      }
    }
  }
},
    "请先登录所选 AI 连接。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign in to the selected AI connection first."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先登入所選 AI 連線。"}}}},
    "AI 服务返回了无法识别的响应。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The AI service returned an unrecognized response."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "AI 服務返回了無法識別的響應。"}}}},
    "AI 服务请求失败（%lld）。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The AI service request failed (%lld)."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "AI 服務請求失敗（%lld）。"}}}},
    "无法安全保存 AI 凭证。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to securely save AI credentials."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法安全儲存 AI 憑證。"}}}},
    "请先选择可用模型。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an available model first."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請先選擇可用模型。"}}}},
    "此连接尚未接入。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This connection is not available yet."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此連線尚未接入。"}}}},
    "无法打开对话记录，请重试。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to open conversations. Please retry."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法開啟對話記錄，請重試。"}}}},
    "无法保存对话。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to save the conversation."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存對話。"}}}},
    "无法保存 AI 设置。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to save AI settings."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存 AI 設定。"}}}},
    "登录未完成，请重试。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sign-in was not completed. Please retry."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "登入未完成，請重試。"}}}},
    "无法移除 AI 凭证。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to remove AI credentials."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法移除 AI 憑證。"}}}},
    "无法保存输入。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to save the draft."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存輸入。"}}}},
    "无法删除对话。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to delete the conversation."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法刪除對話。"}}}},
    "无法保存对话，尚未发送。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to save the conversation. Nothing was sent."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存對話，尚未傳送。"}}}},
    "无法保存已停止的回复。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to save the stopped reply."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存已停止的回覆。"}}}},
    "无法保存回复状态。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to save reply status."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存回覆狀態。"}}}},
    "无法保存回复。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to save the reply."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存回覆。"}}}},
    "网络不可用，请稍后重试。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The network is unavailable. Please retry later."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "網路不可用，請稍後重試。"}}}},
    "AI 请求超时，请重试。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The AI request timed out. Please retry."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "AI 請求超時，請重試。"}}}},
    "AI 请求未完成，请检查连接或重新登录。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The AI request was not completed. Check your connection or sign in again."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "AI 請求未完成，請檢查連線或重新登入。"}}}},
    "此构建不支持 iCloud 阅读数据同步。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This build does not support iCloud reading data sync."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "此構建不支援 iCloud 閱讀資料同步。"}}}},
    "iCloud 账户已变化，阅读数据同步已暂停。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The iCloud account has changed. Reading data sync is paused."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "iCloud 賬戶已變化，閱讀資料同步已暫停。"}}}},
    "账户已再次变化，请重新确认。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The account has changed again. Please confirm again."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "賬戶已再次變化，請重新確認。"}}}},
    "暂时无法连接 iCloud，阅读数据同步未完成。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to connect to iCloud. Reading data sync is incomplete."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫時無法連線 iCloud，閱讀資料同步未完成。"}}}},
    "iCloud 空间不足，阅读数据同步未完成。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud storage is full. Reading data sync is incomplete."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "iCloud 空間不足，閱讀資料同步未完成。"}}}},
    "阅读数据已暂停": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading Data Paused"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "閱讀資料已暫停"}}}},
    "正在处理": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Processing"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在處理"}}}},
    "已保留开启意愿，当前同步暂停。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync remains enabled in your preferences, but is currently paused."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已保留開啟意願，當前同步暫停。"}}}},
    "确认同步到此账户": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm Sync to This Account"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "確認同步到此賬戶"}}}},
    "重试阅读数据同步": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry Reading Data Sync"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重試閱讀資料同步"}}}},
    "是否将本机阅读数据同步到此账户？": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync Local Reading Data to This Account?"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "是否將本機閱讀資料同步到此賬戶？"}}}},
    "同步到此账户": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync to This Account"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "同步到此賬戶"}}}},
    "仅同步当前本机仍存在的阅读数据，不移动小说文件。退出账户后的数据保留遵循系统规则。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync only the reading data currently remaining on this device. Novel files are not moved. Data retention after signing out follows system behavior."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅同步當前本機仍存在的閱讀資料，不移動小說檔案。退出賬戶後的資料保留遵循系統規則。"}}}},
    "阅读统计设置": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading Statistics Settings"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "閱讀統計設定"}}}},
    "统计设置": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Statistics Settings"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "統計設定"}}}},
    "书架与同步": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Library & Sync"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "書架與同步"}}}},
    "应用": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "應用程式"}}}},
    "应用外观": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App Appearance"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "應用程式外觀"}}}},
    "记录中": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recording"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "記錄中"}}}},
    "已暂停": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paused"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已暫停"}}}},
    "阅读数据已开启": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading data on"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "閱讀資料已開啟"}}}},
    "阅读数据已关闭": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading data off"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "閱讀資料已關閉"}}}},
    "阅读数据同步异常": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading data sync issue"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "閱讀資料同步異常"}}}},
    "打开系统设置": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens System Settings"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "開啟系統設定"}}}},
    "%@ · 系统设置": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ · System Settings"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "%@ · 系統設定"}}}},
    "在此设备记录阅读统计": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Record reading statistics on this device"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在此裝置記錄閱讀統計"}}}},
    "清除阅读统计": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear Reading Statistics"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "清除閱讀統計"}}}},
    "清除阅读统计？": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear reading statistics?"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "清除閱讀統計？"}}}},
    "屏幕方向": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Screen Orientation"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "螢幕方向"}}}},
    "当前无法切换屏幕方向，已恢复跟随系统。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to change screen orientation. System orientation has been restored."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "當前無法切換螢幕方向，已恢復跟隨系統。"}}}},
    "阅读数据同步": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading Data Sync"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "閱讀資料同步"}}}},
    "我的书架文件": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"My Library Files"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "我的書架檔案"}}}},
    "同步进度、书签、批注、小说信息、配色方案和阅读统计。显示与阅读偏好留在此设备；此开关不控制小说文件。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Syncs positions, bookmarks, annotations, book information, color palettes, and reading statistics. Display and reading preferences stay on this device. This switch does not control novel files."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "同步進度、書籤、批註、小說資訊、配色方案和閱讀統計。顯示與閱讀偏好留在此裝置；此開關不控制小說檔案。"}}}},
    "我的书架由应用管理固定的本机与 iCloud 目录，小说文件由 iCloud Drive 同步。外部文件夹仍在原位置管理。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The app manages fixed local and iCloud folders for My Library. iCloud Drive syncs novel files. External folders remain at their original locations."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "我的書架由應用程式管理固定的本機與 iCloud 目錄，小說檔案由 iCloud Drive 同步。外部資料夾仍在原位置管理。"}}}},
    "小说保存在我的书架或你添加的目录；我的书架可接入应用固定的 iCloud 文件目录。阅读数据可选择通过 iCloud 同步，显示与阅读偏好保存在此设备。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Novels are stored in My Library or folders you add. My Library can use the app’s fixed iCloud folder. Reading data can optionally sync through iCloud; display and reading preferences stay on this device."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "小說儲存在我的書架或你新增的目錄；我的書架可接入應用程式固定的 iCloud 檔案目錄。閱讀資料可選擇通過 iCloud 同步，顯示與閱讀偏好儲存在此裝置。"}}}},
    "已选择删除，完成后移除批注": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion selected. Done will remove the annotation."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已選擇刪除，完成後移除批註"}}}},
    "已选定结果，可继续编辑": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Result selected. Continue editing below."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已選定結果，可繼續編輯"}}}},
    "重新选择": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose Again"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新選擇"}}}},
    "批注存在并发修改": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Conflicting Annotation Edits"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "批註存在併發修改"}}}},
    "使用上面": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Above"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用上面"}}}},
    "使用下面": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Below"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用下面"}}}},
    "使用这项": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use This"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用這項"}}}},
    "保留两者": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep Both"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "保留兩者"}}}},
    "删除这条批注": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete This Annotation"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "刪除這條批註"}}}},
    "仅高亮": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Highlight Only"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅高亮"}}}},
    "选择范围后，可在下方手动编辑最终评论。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a range, then edit the final comment below."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇範圍後，可在下方手動編輯最終評論。"}}}},
    "这条批注存在并发修改，请在编辑页处理。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This annotation has conflicting edits. Resolve them in the editor."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "這條批註存在併發修改，請在編輯頁處理。"}}}},
