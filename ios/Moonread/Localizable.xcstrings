      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "無法驗證 ChatGPT 賬戶，請檢查連線授權。"
        }
      }
    }
  },
    "ChatGPT 套餐授权范围不允许此操作，请检查授权配置。": {
    "localizations": {
      "en": {
        "stringUnit": {
