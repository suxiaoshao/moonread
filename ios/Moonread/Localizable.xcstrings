    "加载较早消息": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Load Earlier Messages"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "載入較早訊息"}}}},
    "回到底部": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back to Bottom"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "回到底部"}}}},
