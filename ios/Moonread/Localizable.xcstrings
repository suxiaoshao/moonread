    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "轻点屏幕中间，显示或隐藏阅读工具。分页模式下，点左右两侧或左右滑动翻页；滚动模式下，上下滑动即可。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Tap the middle of the screen to show or hide reading controls. In paged mode, tap either side or swipe horizontally to turn pages. In scrolling mode, swipe vertically."
