        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "ChatGPT 套餐授權範圍不允許此操作，請檢查授權配置。"
        }
      }
    }
  },
    "ChatGPT 账户或工作区暂时不可用，请稍后再试。": {
    "localizations": {
      "en": {
        "stringUnit": {
