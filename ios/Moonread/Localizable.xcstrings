    "目标目录中已有“%@”，替换后将使用新文件。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"“%@” already exists in this folder. Replace it with the new file?"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "目標目錄中已有“%@”，替換後將使用新檔案。"}}}},
    "目标目录中已有“%@”。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"“%@” already exists in this folder."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "目標目錄中已有“%@”。"}}}},
