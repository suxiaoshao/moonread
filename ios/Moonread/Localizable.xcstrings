        }
      }
    }
  },
    "无法验证 ChatGPT 账户，请检查连接授权。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The ChatGPT account could not be validated. Check connection authorization."
