    "%llu 本 · %@": {
  "localizations": {
    "en": {
      "stringUnit": {
        "state": "translated",
        "value": "%#@books@ · %2$@"
      },
      "substitutions": {
        "books": {
          "argNum": 1,
          "formatSpecifier": "llu",
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%arg book"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%arg books"
                }
              }
            }
          }
        }
      }
    },
    "zh-Hant": {
      "stringUnit": {
        "state": "translated",
        "value": "%llu 本 · %@"
      }
    }
  },
  "comment": "Shelf summary: argument 1 is book count; argument 2 is the storage location label."
},
    "%llu 本小说": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%llu books"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "%llu 本小說"}}}},
    "%lld 个文件夹 · %lld 个文件": {
