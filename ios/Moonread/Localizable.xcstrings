    "请选择 TXT 小说文件。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Please select TXT book files."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請選擇 TXT 小說檔案。"}}}},
