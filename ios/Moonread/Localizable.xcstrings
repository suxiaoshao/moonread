{
  "sourceLanguage": "zh-Hans",
  "strings": {
  "服务说明：%@": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Service details: %@"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "服务说明：%@"
        }
      }
    }
  },
  "ChatGPT 客户端配置无效，请检查连接配置。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The ChatGPT client configuration is invalid. Check the connection settings."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "ChatGPT 客户端配置无效，请检查连接配置。"
        }
      }
    }
  },
  "ChatGPT 登录已失效，请重新授权。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Your ChatGPT sign-in has expired. Authorize again."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "ChatGPT 登录已失效，请重新授权。"
        }
      }
    }
  },
  "此 ChatGPT 账户或工作区不允许套餐共享，请检查账户权限。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This ChatGPT account or workspace is not eligible for plan sharing. Check account permissions."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此 ChatGPT 账户或工作区不允许套餐共享，请检查账户权限。"
        }
      }
    }
  },
  "暂时无法确认 ChatGPT 套餐用量，请稍后再试。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "ChatGPT plan usage cannot be checked right now. Try again later."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "暂时无法确认 ChatGPT 套餐用量，请稍后再试。"
        }
      }
    }
  },
  "ChatGPT 套餐不支持此请求能力，请调整输入、工具或模型后再试。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Your ChatGPT plan does not support this capability. Adjust the input, tools, or model before trying again."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "ChatGPT 套餐不支持此请求能力，请调整输入、工具或模型后再试。"
        }
      }
    }
  },
  "ChatGPT 套餐不支持此请求接口，请检查连接配置。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Your ChatGPT plan does not support this route. Check the connection settings."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "ChatGPT 套餐不支持此请求接口，请检查连接配置。"
        }
      }
    }
  },
  "无法验证 ChatGPT 账户，请检查连接授权。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The ChatGPT account could not be validated. Check connection authorization."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法验证 ChatGPT 账户，请检查连接授权。"
        }
      }
    }
  },
  "ChatGPT 套餐授权范围不允许此操作，请检查授权配置。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The ChatGPT plan grant does not authorize this operation. Check the authorization settings."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "ChatGPT 套餐授权范围不允许此操作，请检查授权配置。"
        }
      }
    }
  },
  "ChatGPT 账户或工作区暂时不可用，请稍后再试。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The ChatGPT account or workspace is temporarily unavailable. Try again later."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "ChatGPT 账户或工作区暂时不可用，请稍后再试。"
        }
      }
    }
  },
  "ChatGPT 请求失败，请检查服务返回的错误。": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The ChatGPT request failed. Check the error returned by the service."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "ChatGPT 请求失败，请检查服务返回的错误。"
        }
      }
    }
  },
  "错误代码：%@": {
    "localizations": {
