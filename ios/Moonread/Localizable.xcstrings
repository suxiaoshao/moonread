    "阅读统计已暂停": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading Statistics Paused"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "閱讀統計已暫停"}}}},
    "清除本书统计": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear Book Statistics"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "清除本書統計"}}}},
    "清除本书的阅读统计？": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear this book’s reading statistics?"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "清除本書的閱讀統計？"}}}},
    "清除统计": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear Statistics"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "清除統計"}}}},
    "删除记录": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete Activity"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "刪除記錄"}}}},
    "删除本次阅读记录": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete Reading Session"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "刪除本次閱讀記錄"}}}},
    "删除本次阅读记录？": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete this reading session?"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "刪除本次閱讀記錄？"}}}},
    "删除这次开书产生的统计片段，正文和续读位置会保留。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all activity from this reading session. The book and reading position are kept."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "刪除這次開書產生的統計片段，正文和續讀位置會保留。"}}}},
    "正文、续读位置、书签和笔记会保留。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your books, reading positions, bookmarks and notes are kept."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正文、續讀位置、書籤和筆記會保留。"}}}},
    "只记录可见正文的阅读活动。锁屏、后台和工具面板中暂停；连续 2 分钟没有正文操作后暂停，再次操作恢复。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Records time spent reading visible text. Pauses when locked, in the background or in reader tools, and after 2 minutes without interaction. Interacting with the text resumes recording."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "只記錄可見正文的閱讀活動。鎖屏、後臺和工具面板中暫停；連續 2 分鐘沒有正文操作後暫停，再次操作恢復。"}}}},
    "不影响小说文件、续读位置、书签和笔记。历史阅读时长无法由旧进度补算。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Books, reading positions, bookmarks and notes are unaffected. Past reading time cannot be reconstructed from old positions."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "不影響小說檔案、續讀位置、書籤和筆記。歷史閱讀時長無法由舊進度補算。"}}}},
    "小说文件": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Book Files"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "小說檔案"}}}},
    "小说保存在本机": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Books are stored on this device"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "小說儲存在本機"}}}},
    "小说保存在 iCloud Drive": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Books are stored in iCloud Drive"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "小說儲存在 iCloud Drive"}}}},
    "未登录 iCloud，小说保存在本机。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not signed in to iCloud. Books are stored on this device."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "未登入 iCloud，小說儲存在本機。"}}}},
    "iCloud Drive 暂时不可用。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud Drive is temporarily unavailable."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "iCloud Drive 暫時不可用。"}}}},
    "iCloud 账户已变化，原账户的本机文件不会自动上传。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The iCloud account changed. Local files from the previous account will not upload automatically."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "iCloud 賬戶已變化，原賬戶的本機檔案不會自動上傳。"}}}},
    "本机与 iCloud 有同名文件，原件已保留。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local and iCloud files have the same name. Both originals have been kept."}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "本機與 iCloud 有同名檔案，原件已保留。"}}}},
    "阅读数据 iCloud 同步": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync Reading Data with iCloud"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "閱讀資料 iCloud 同步"}}}},
    "正在同步": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Syncing"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在同步"}}}},
