{"sourceLanguage":"zh-Hans","strings":{
    "存储空间": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Storage"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存空間"}}}},
    "阅读与封面缓存": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading and Cover Caches"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"閱讀與封面快取"}}}},
    "过时的导入文件": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Obsolete Import Files"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"過時的匯入檔案"}}}},
    "已经迁入的旧索引": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Migrated Index"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已遷入的舊索引"}}}},
    "已清理约 %@，部分项目保留。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cleared about %@. Some items were kept."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已清理約 %@，部分項目保留。"}}}},
    "已清理约 %@。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cleared about %@."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已清理約 %@。"}}}},
    "请在阅读数据同步或其他任务结束后再整理。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try again when reading data sync and other tasks are finished."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請在閱讀資料同步或其他任務結束後再整理。"}}}},
    "正文与封面": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Book Text and Covers"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正文與封面"}}}},
    "阅读数据库": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading Databases"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"閱讀資料庫"}}}},
    "导入与临时文件": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Imports and Temporary Files"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"匯入與暫存檔案"}}}},
    "旧版数据": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Legacy Data"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"舊版資料"}}}},
    "App 本体": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"App 本體"}}}},
    "其他": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"其他"}}}},
    "本机书架文件": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-Device Library Files"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機書架檔案"}}}},
    "对话与附件": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Conversations and Attachments"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"對話與附件"}}}},
    "已安装字体": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Installed Fonts"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已安裝字體"}}}},
    "系统界面快照": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System Snapshots"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"系統介面快照"}}}},
    "其他缓存": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other Caches"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"其他快取"}}}},
    "偏好与其他文件": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preferences and Other Files"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"偏好與其他檔案"}}}},
    "月读总占用": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Moonread Storage Used"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"月讀總用量"}}}},
    "按类别管理": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage by Category"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"依類別管理"}}}},
    "选择清理项目": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose Items to Clear"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇清理項目"}}}},
    "可管理内容": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage Storage"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可管理內容"}}}},
    "离线正文": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Offline Book Text"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"離線正文"}}}},
    "其余任务与临时文件": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other Task and Temporary Files"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"其餘任務與暫存檔案"}}}},
    "暂时保留": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Kept for Now"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"暫時保留"}}}},
    "任务使用的正文": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Book Text Used by Tasks"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"任務使用的正文"}}}},
    "%lld 本等待继续导入": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld awaiting import"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%lld 本等待繼續匯入"}}}},
    "正文保存在索引库内，清理后空闲空间可继续使用。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clearing book text frees space for reuse inside the index."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正文儲存在索引庫內，清理後的空閒空間可繼續使用。"}}}},
    "可清理": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Available to Clear"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可清理"}}}},
    "导入任务的原包": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import Source Packages"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"匯入任務的原始套件"}}}},
    "暂时无法核对原包归属": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t verify which tasks use these packages"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"暫時無法核對原始套件的歸屬"}}}},
    "旧版阅读数据": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Legacy Reading Data"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"舊版閱讀資料"}}}},
    "尚未确认完整迁入": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Full migration is unverified"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未確認完整遷入"}}}},
    "仅查看": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Storage Details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"僅供查看"}}}},
    "移除后需要重新取得同一份原文才能继续阅读。进度、书签和批注会保留。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You’ll need the same original text to read again. Progress, bookmarks, and notes are kept."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"移除後須重新取得同一份原文才能繼續閱讀。進度、書籤和批註會保留。"}}}},
    "移除本机正文": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove Local Book Text"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"移除本機正文"}}}},
    "选择要清理的内容": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select Items to Clear"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇要清理的內容"}}}},
    "暂无可清理项目": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No items available to clear"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"暫無可清理項目"}}}},
    "将关闭的阅读页：%@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading pages to close: %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將關閉的閱讀頁面：%@"}}}},
    "移除所选本机正文": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove Selected Offline Text"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"移除所選本機正文"}}}},
    "清理所选项目": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear Selected Items"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清理所選項目"}}}},
    "清理 %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清理 %@"}}}},
    "正在清理…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clearing…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在清理…"}}}},
    "正在取消…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancelling\u2026"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在取消…"}}}},
    "已取消，已清理 %@。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancelled. Cleared %@."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已取消，已清理 %@。"}}}},
    "正在统计占用": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Measuring storage"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在統計用量"}}}},
    "将移除约 %@ 的本机正文。再次阅读需要重新取得原文。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About %@ of offline text will be removed. You’ll need the original files to read again."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將移除約 %@ 的本機正文。再次閱讀時須重新取得原文。"}}}},
    "将清理%@，约 %@。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This will clear %1$@, about %2$@."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將清理%1$@，約 %2$@。"}}}},
    "将保存进度并关闭%@。听书和自动阅读也会停止。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Progress will be saved and %@ will close. Listening and auto-reading will stop."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將儲存進度並關閉%@。聽書和自動閱讀也會停止。"}}}},
    "关闭阅读页并清理？": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Close Reading Pages and Clear?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關閉閱讀頁面並清理？"}}}},
    "移除所选本机正文？": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove Selected Offline Text?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"移除所選本機正文？"}}}},
    "清理所选项目？": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear Selected Items?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清理所選項目？"}}}},
    "移除": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"移除"}}}},
    "关闭并移除": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Close and Remove"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關閉並移除"}}}},
    "清理": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清理"}}}},
    "关闭并清理": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Close and Clear"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關閉並清理"}}}},
    "正在整理…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optimizing\u2026"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在整理…"}}}},
    "整理开始后无法取消。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optimization can\u2019t be cancelled once it starts."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整理開始後無法取消。"}}}},
    "当前阅读数据库": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current Reading Database"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前的閱讀資料庫"}}}},
    "可复用的空闲空间": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Space Available for Reuse"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可重複使用的空閒空間"}}}},
    "未使用的封面": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unused Covers"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未使用的封面"}}}},
    "%lld 个": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%lld 個"}}}},
    "其他阅读数据库": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other Reading Databases"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"其他閱讀資料庫"}}}},
    "整理会移除无引用的封面并收回数据库空闲空间。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optimize removes unused covers and reclaims unused database space."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整理會移除無引用的封面並收回資料庫的空閒空間。"}}}},
    "整理数据库": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optimize Database"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整理資料庫"}}}},
    "已清除未使用的封面，数据库尚未整理。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unused covers were removed. The database hasn’t been optimized yet."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已清除未使用的封面，資料庫尚未整理。"}}}},
    "数据库已整理": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Database Optimized"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"資料庫已整理"}}}},
    "整理结果": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optimization Result"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整理結果"}}}},
    "清除未使用的封面": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unused Covers Removed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除未使用的封面"}}}},
    "数据库文件减少": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Database Space Reclaimed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"資料庫檔案減少"}}}},
    "整理当前账户的阅读数据库？": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optimize the Current Reading Database?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整理目前帳戶的閱讀資料庫？"}}}},
    "整理": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optimize"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整理"}}}},
    "将清除 %lld 个未使用的封面。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unused covers to remove: %lld."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將清除 %lld 個未使用的封面。"}}}},
    "将收回空闲空间。进度、批注和正在使用的封面会保留。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unused space will be reclaimed. Progress, notes, and covers in use will be kept."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將收回空閒空間。進度、批註和正在使用的封面會保留。"}}}}
},"version":"1.0"}
