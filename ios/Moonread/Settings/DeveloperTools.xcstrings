{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%llu 份相同正文 · 共用资料": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%llu copies of the same text · shared information"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%llu 份相同正文 · 共用资料"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%llu 份相同正文 · 共用資料"}}}},
    "保留阅读状态和阅读记录。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading status and reading records are kept."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留阅读状态和阅读记录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"保留閱讀狀態和閱讀記錄。"}}}},
    "全选搜索结果": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select All Search Results"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全选搜索结果"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"全選搜尋結果"}}}},
    "前往数据管理": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Data Management"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前往数据管理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"前往資料管理"}}}},
    "可以前往数据管理重新导入小说信息。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Data Management to import book information again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以前往数据管理重新导入小说信息。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可以前往資料管理重新匯入小說資訊。"}}}},
    "导入测试": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import testing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入测试"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"匯入測試"}}}},
    "小说资料任务尚未结束，请结束任务后再清理。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Finish the current book information task before clearing information."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"小说资料任务尚未结束，请结束任务后再清理。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"小說資料任務尚未結束，請結束任務後再清除。"}}}},
    "已清理 %lld 本的资料": {"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Cleared information for %lld book"}},"other":{"stringUnit":{"state":"translated","value":"Cleared information for %lld books"}}}}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已清理 %lld 本的资料"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已清除 %lld 本的資料"}}}},
    "已选 %lld 本": {"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld book selected"}},"other":{"stringUnit":{"state":"translated","value":"%lld books selected"}}}}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已选 %lld 本"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已選 %lld 本"}}}},
    "开发者": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Developer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开发者"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開發者"}}}},
    "当前资料库": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current Library"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前资料库"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前資料庫"}}}},
    "所选小说没有需要清理的内容。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected books have no information to clear."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选小说没有需要清理的内容。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"所選小說沒有需要清除的內容。"}}}},
    "手动阅读状态将恢复为默认值，阅读进度和其他阅读记录保留。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manual reading status will reset to its default. Reading progress and other reading records are kept."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"手动阅读状态将恢复为默认值，阅读进度和其他阅读记录保留。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手動閱讀狀態將恢復為預設值，閱讀進度和其他閱讀記錄會保留。"}}}},
    "搜索小说": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search Books"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索小说"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"搜尋小說"}}}},
    "暂无可选小说": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Books to Select"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂无可选小说"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"暫無可選取的小說"}}}},
    "暂时无法读取小说资料": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t Read Book Information"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法读取小说资料"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"暫時無法讀取小說資料"}}}},
    "未选择": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"None selected"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未选择"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未選取"}}}},
    "本机资料库": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-Device Library"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机资料库"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機資料庫"}}}},
    "本次清理只写入本机资料库。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cleanup only changes the on-device library."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本次清理只写入本机资料库。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本次清除只會寫入本機資料庫。"}}}},
    "正在清理小说资料": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clearing book information"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在清理小说资料"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在清除小說資料"}}}},
    "清理": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除"}}}},
    "清理 %lld 本小说的资料：%@。": {"localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Clear this information from %lld book: %@."}},"other":{"stringUnit":{"state":"translated","value":"Clear this information from %lld books: %@."}}}}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清理 %lld 本小说的资料：%@。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除 %lld 本小說的資料：%@。"}}}},
    "清理会通过 iCloud 同步到使用此账户和环境的其他设备。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Changes will sync through iCloud to other devices using this account and environment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清理会通过 iCloud 同步到使用此账户和环境的其他设备。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除結果會透過 iCloud 同步到使用此帳號和環境的其他裝置。"}}}},
    "清理内容": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Information to Clear"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清理内容"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除內容"}}}},
    "清理写入账户资料库，恢复同步后会更新使用此账户和环境的其他设备。": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Changes are saved to the account library and will sync to other devices using this account and environment when syncing resumes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清理写入账户资料库，恢复同步后会更新使用此账户和环境的其他设备。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除結果會寫入帳號資料庫，恢復同步後會更新使用此帳號和環境的其他裝置。"}}}},
    "清理对象": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Books to Clear"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清理对象"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除對象"}}}},
    "清理小说资料": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear Book Information"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清理小说资料"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除小說資料"}}}},
    "清理小说资料？": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear Book Information?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清理小说资料？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除小說資料？"}}}},
    "清理结果": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cleanup Result"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清理结果"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除結果"}}}},
    "账户资料库": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Account Library"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户资料库"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳號資料庫"}}}},
    "账户资料库 · 开发环境": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Account Library · Development"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户资料库 · 开发环境"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳號資料庫 · 開發環境"}}}},
    "账户资料库 · 生产环境": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Account Library · Production"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户资料库 · 生产环境"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳號資料庫 · 正式環境"}}}},
    "选择小说": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select Books"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择小说"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇小說"}}}}
