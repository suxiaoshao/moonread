// Tool versions and installed Rust targets are owned by flake.nix / flake.lock.
MOONREAD_NIX = /nix/var/nix/profiles/default/bin/nix

MOONREAD_CARGO_PROFILE = dev
MOONREAD_CARGO_PROFILE[config=Release] = release
MOONREAD_CARGO_OUTPUT = debug
MOONREAD_CARGO_OUTPUT[config=Release] = release

MOONREAD_RUST_TARGET[sdk=iphoneos*][arch=arm64] = aarch64-apple-ios
MOONREAD_RUST_TARGET[sdk=iphonesimulator*][arch=arm64] = aarch64-apple-ios-sim

// Simulator builds use the Apple Silicon target only.
MOONREAD_RUST_TARGET_FLAGS[sdk=iphoneos*] = --target aarch64-apple-ios
MOONREAD_RUST_TARGET_FLAGS[sdk=iphonesimulator*] = --target aarch64-apple-ios-sim
MOONREAD_BINDGEN_TARGET[sdk=iphoneos*] = aarch64-apple-ios
MOONREAD_BINDGEN_TARGET[sdk=iphonesimulator*] = aarch64-apple-ios-sim

MOONREAD_BINDINGS_DIR = $(SRCROOT)/../build/ios/Generated/$(CONFIGURATION)
MOONREAD_BINDGEN_LIBRARY = $(SRCROOT)/../target/$(MOONREAD_BINDGEN_TARGET)/$(MOONREAD_CARGO_OUTPUT)/libmoonread_core.a
LIBRARY_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../target/$(MOONREAD_RUST_TARGET)/$(MOONREAD_CARGO_OUTPUT)"
